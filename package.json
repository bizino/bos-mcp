{
  "name": "bos-mcp",
  "version": "1.0.0",
  "description": "BOS ERP MCP Server - Connect AI assistants to BOS System via REST API",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "bos-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio.js",
    "http": "node dist/http.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "bos",
    "erp",
    "mcp",
    "model-context-protocol",
    "ai",
    "laravel",
    "ecommerce",
    "pos"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
